@* =========================================================================
   MẸO ĐI THI: COPY 100% file `givenHTML/Index.html` dán vào đây, rồi sửa đúng các chỗ có dấu 🔧 bên dưới!
   TUYỆT ĐỐI KHÔNG tự thêm/xóa thẻ HTML hay bọc thêm <span> vào các <td> thuần text vì Selenium chấm theo DOM & ID!
   ========================================================================= *@
@* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Đổi `TrainerSearchDTO` & `SpecializationDTO` theo tên class DTO mới ở Controller *@
@model List<Q2.Controllers.TrainerSearchDTO>
@{
    var specs = ViewBag.Specs as List<Q2.Controllers.SpecializationDTO> ?? new List<Q2.Controllers.SpecializationDTO>(); // 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Khớp ViewBag & kiểu DTO dropdown
    int selectedSpecId = ViewBag.SelectedSpecId ?? 0; // 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Giá trị đã chọn (int hay string tùy dropdown)
    string trainerName = ViewBag.TrainerName ?? "";   // 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Từ khóa ô tìm kiếm
}
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
</head>
<body>
    <div class="gym-wrap">
        <h2 style="margin-top: 0; margin-bottom: 20px;">Trainer Booking Directory</h2>

        @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Sửa `action="/Trainer"` thành route trang chính trong đề PDF *@
        <form method="get" action="/Trainer" class="filter-section">
            <div class="filter-item">
                <label>Specialization:</label>
                @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: `name="specId"` PHẢI KHỚP tên tham số Action Index; `id="sl_specializations"` giữ nguyên theo givenHTML! *@
                <select name="specId" id="sl_specializations">
                    @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Option mặc định: check kỹ `value`, `id` (op_0 / op_all) và chữ trong givenHTML *@
                    @if (selectedSpecId == 0)
                    {
                        <option value="0" id="op_0" selected>All specializations</option>
                    }
                    else
                    {
                        <option value="0" id="op_0">All specializations</option>
                    }

                    @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Vòng lặp option từ API: sửa thuộc tính `sp.SpecID`, `sp.SpecName` & mẫu `id="op_@sp.SpecID"` theo givenHTML *@
                    @foreach (var sp in specs)
                    {
                        if (selectedSpecId == sp.SpecID)
                        {
                            <option value="@sp.SpecID" id="op_@sp.SpecID" selected>@sp.SpecName</option>
                        }
                        else
                        {
                            <option value="@sp.SpecID" id="op_@sp.SpecID">@sp.SpecName</option>
                        }
                    }
                </select>
            </div>

            <div class="filter-item">
                <label>Trainer Name:</label>
                @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: `name="trainerName"` khớp tham số Action Index; giữ nguyên `id="ip_trainerName"` từ givenHTML *@
                <input type="text" name="trainerName" id="ip_trainerName" value="@trainerName" placeholder="Enter trainer name...">
            </div>

            @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Giữ nguyên `id="bt_search"` từ givenHTML *@
            <button type="submit" id="bt_search" class="btn-submit">Search</button>
        </form>

        <table class="trainer-table">
            <thead>
                <tr>
                    <th style="width: 250px;">Trainer Name</th>
                    <th style="width: 250px;">Email</th>
                    <th style="width: 150px;">Experience Years</th>
                    <th style="width: 250px;">Specializations</th>
                    <th style="width: 150px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Mở givenHTML xóa hết <tr> mẫu, chỉ giữ 1 <tr> đầu tiên rồi bọc @foreach (var t in Model) *@
                @foreach (var t in Model)
                {
                    <tr>
                        @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Sửa ID động `td_..._@t.TrainerID` & `@t.ThuocTinh` khớp givenHTML; KHÔNG bọc thêm <span> vào <td>! *@
                        <td id="td_name_@t.TrainerID">@t.TrainerName</td>
                        <td id="td_email_@t.TrainerID">@t.Email</td>
                        <td id="td_exp_@t.TrainerID">@t.ExperienceYears</td>
                        <td>
                            @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Nếu có cột chứa nhiều tag/badge, giữ đúng pattern `id="span_@(sp.SpecName)_@sp.SpecID"` trong givenHTML *@
                            @foreach (var sp in t.Specializations)
                            {
                                <span id="span_@(sp.SpecName)_@sp.SpecID" class="spec-badge">@sp.SpecName</span>
                            }
                        </td>
                        <td>
                            @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Đổi đường dẫn `/Trainer/Analyze/@t.TrainerID` + giữ đúng mẫu `id="a_@t.TrainerID"` *@
                            <a href="/Trainer/Analyze/@t.TrainerID" id="a_@t.TrainerID" class="btn-action">Analyze Schedule</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
