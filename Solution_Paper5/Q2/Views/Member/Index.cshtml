@* =========================================================================
   MẸO ĐI THI: COPY 100% file `givenHTML/Member.html` dán vào đây rồi sửa các chỗ 🔧!
   TUYỆT ĐỐI KHÔNG tự thêm/xóa thẻ HTML hay bọc thêm <span> vào các <td> thuần text!
   ========================================================================= *@
@* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Đổi `MemberSearchDTO` thành tên class DTO danh sách mới ở Controller *@
@model List<Q2.Controllers.MemberSearchDTO>
@{
    var statuses = ViewBag.Statuses as List<string> ?? new List<string>(); // 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Khớp ViewBag & kiểu dữ liệu dropdown (`List<string>` hoặc `List<TenDTO>`)
    string selectedStatus = ViewBag.SelectedStatus ?? "All statuses";       // 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Giá trị mặc định ô "Tất cả"
    string memberName = ViewBag.MemberName ?? "";                           // 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Từ khóa ô tìm kiếm
}
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8">
</head>
<body>
    <div class="gym-container">
        <h2 style="margin-top: 0; margin-bottom: 20px;">Gym Member Directory Management</h2>

        @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Sửa `action="/Member"` thành route trang chính trong đề PDF *@
        <form method="get" action="/Member" class="filter-section">
            <div class="filter-item">
                <label>Member Name:</label>
                @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: `name="memberName"` PHẢI KHỚP tham số Action Index; giữ nguyên `id="ip_memberName"` từ givenHTML *@
                <input type="text" name="memberName" id="ip_memberName" value="@memberName" placeholder="Enter member name...">
            </div>

            <div class="filter-item">
                <label>Booking Status:</label>
                @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: `name="bookingStatus"` khớp tham số Action Index; giữ nguyên `id="sl_bookingStatus"` từ givenHTML *@
                <select name="bookingStatus" id="sl_bookingStatus">
                    @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Kiểm tra `value`, `id="op_all"`, và text `"All statuses"` trong givenHTML *@
                    @if (selectedStatus == "All statuses")
                    {
                        <option value="All statuses" id="op_all" selected>All statuses</option>
                    }
                    else
                    {
                        <option value="All statuses" id="op_all">All statuses</option>
                    }

                    @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Chú ý quy tắc tạo `id` cho option trong givenHTML (vd: `"op_" + s.Replace(" ", "_")` hay `"op_" + item.Id`) *@
                    @foreach (var s in statuses)
                    {
                        var opId = "op_" + s.Replace(" ", "_");
                        if (selectedStatus == s)
                        {
                            <option value="@s" id="@opId" selected>@s</option>
                        }
                        else
                        {
                            <option value="@s" id="@opId">@s</option>
                        }
                    }
                </select>
            </div>

            @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Giữ nguyên `id="bt_search"` từ givenHTML *@
            <button type="submit" id="bt_search" class="btn-submit">Search</button>
        </form>

        <table class="member-table">
            <thead>
                <tr>
                    <th style="width: 250px;">Member Name</th>
                    <th style="width: 200px;">Join Date</th>
                    <th style="width: 250px;">Assigned Package</th>
                    <th style="width: 150px;">Action</th>
                </tr>
            </thead>
            <tbody>
                @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Mở givenHTML xóa hết <tr> mẫu, giữ 1 <tr> đầu tiên bọc @foreach (var m in Model) *@
                @foreach (var m in Model)
                {
                    <tr>
                        @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Giữ đúng mẫu `id="td_..._@m.MemberID"`, format ngày `.ToString("yyyy-MM-dd")`; KHÔNG bọc thêm <span> vào <td>! *@
                        <td id="td_name_@m.MemberID">@m.FullName</td>
                        <td id="td_joinDate_@m.MemberID">@m.JoinDate.ToString("yyyy-MM-dd")</td>
                        <td id="td_package_@m.MemberID">@m.PackageName</td>
                        <td>
                            @* 🔧 [ĐỔI ĐỀ SỬA CHỖ NÀY]: Sửa đường dẫn `/Member/Analyze/@m.MemberID` + giữ đúng `id="a_@m.MemberID"` *@
                            <a href="/Member/Analyze/@m.MemberID" id="a_@m.MemberID" class="btn-action">Analyze Sales</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</body>
</html>
